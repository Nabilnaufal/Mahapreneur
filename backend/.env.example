APP_NAME=Mahapreneur
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# URL frontend (dipakai untuk tautan email).
APP_URL=http://localhost:3000
# URL backend ini (dipakai untuk URL gambar dan callback DOKU).
API_URL=http://localhost:4000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database — default XAMPP: user root tanpa password di port 3306.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mahapreneur
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# CORS: origin frontend, pisahkan dengan koma bila lebih dari satu.
CORS_ORIGIN=http://localhost:3000

# Email. Biarkan MAIL_MAILER=log untuk pengembangan: isi email masuk ke storage/logs.
# Untuk email sungguhan ganti ke smtp dan isi host/kredensial di bawah.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@mahapreneur.test"
MAIL_FROM_NAME="Mahapreneur"

# Upload
MAX_UPLOAD_MB=5

# Auth
AUTH_TTL_DAYS=7
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# DOKU Sandbox. Kosongkan client ID/secret untuk mode simulasi pembayaran.
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_QRIS_CHANNEL=QRIS
DOKU_VA_CHANNEL=BCA
DOKU_EWALLET_CHANNEL=SHOPEEPAY
PAYMENT_TTL_MINUTES=60
