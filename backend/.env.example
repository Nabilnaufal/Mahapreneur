APP_NAME="Mahapreneur"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# URL backend Laravel.
APP_URL=http://localhost:8000
# URL frontend Nuxt (dipakai untuk tautan email dan CORS).
FRONTEND_URL=http://localhost:3000
# URL backend ini (dipakai untuk URL gambar dan callback DOKU).
API_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database — default XAMPP: user root tanpa password di port 3306.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mahapreneur
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# CORS: origin FRONTEND (port 3000), bukan port backend. Pisahkan dengan koma bila lebih dari satu.
CORS_ORIGIN=http://localhost:3000

# Email Resend. Buat API key di https://resend.com/api-keys.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="noreply@nabil-naufal.online"
MAIL_FROM_NAME="Mahapreneur"

# Upload
MAX_UPLOAD_MB=5

# Auth
AUTH_TTL_DAYS=7
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# DOKU Sandbox. Kosongkan client ID/secret untuk menyembunyikan metode online (hanya COD).
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_QRIS_CHANNEL=QRIS
DOKU_VA_CHANNEL=BCA
DOKU_METHODS=SHOPEEPAY
PAYMENT_TTL_MINUTES=60
