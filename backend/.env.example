# Database — default XAMPP: user root tanpa password di port 3306.
DATABASE_URL="mysql://root@127.0.0.1:3306/mahapreneur"

# Server
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# Email (Nodemailer). Kosongkan SMTP_HOST untuk mode dev: email dicetak ke console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mahapreneur <no-reply@mahapreneur.test>"

# Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# DOKU Sandbox. Isi kredensial asli dari dashboard DOKU untuk mengaktifkan pembayaran online.
# Bila DOKU_CLIENT_ID / DOKU_SECRET_KEY kosong, backend memakai mode simulasi pembayaran
# (khusus pengembangan) dan menandainya jelas pada response.
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_MODE=sandbox
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_QRIS_CHANNEL=QRIS
DOKU_VA_CHANNEL=BCA
DOKU_EWALLET_CHANNEL=SHOPEEPAY
# Batas waktu pembayaran (menit) sebelum transaksi dianggap kedaluwarsa.
PAYMENT_TTL_MINUTES=60
